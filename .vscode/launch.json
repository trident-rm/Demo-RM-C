{
  "version": "0.2.0",
  "inputs": [
    {
      "id": "buildType",
      "type": "pickString",
      "default": "Debug",
      "description": "需和当前使用的 CMake Build Type 一致",
      "options": ["Debug", "Release"]
    },
    {
      "id": "probe",
      "type": "pickString",
      "default": "cmsis-dap",
      "description": "需和当前使用的调试探针一致",
      "options": ["cmsis-dap", "stlink", "jlink"]
    }
  ],
  "configurations": [
    {
      "name": "Cortex-Debug: Launch",
      "type": "cortex-debug",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "executable": "./build/${input:buildType}/Demo-RM-C.elf",
      "servertype": "openocd",
      "gdbPath": "arm-none-eabi-gdb",
      "configFiles": ["./openocd/${input:probe}.cfg"],
      "svdFile": "./STM32F407.svd",
      "rtos": "auto",
      "runToEntryPoint": "main",
      "liveWatch": {
        "enabled": true,
        "samplesPerSecond": 4
      }
    },
    {
      "name": "Cortex-Debug: Attach",
      "type": "cortex-debug",
      "request": "attach",
      "cwd": "${workspaceFolder}",
      "executable": "./build/${input:buildType}/Demo-RM-C.elf",
      "servertype": "openocd",
      "gdbPath": "arm-none-eabi-gdb",
      "configFiles": ["./openocd/${input:probe}.cfg"],
      "svdFile": "./STM32F407.svd",
      "rtos": "auto",
      "liveWatch": {
        "enabled": true,
        "samplesPerSecond": 4
      }
    }
  ]
}
